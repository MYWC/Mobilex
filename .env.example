VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=development
VITE_PUBLIC_APP_URL=https://your-domain.example
VITE_OBSERVABILITY_ENDPOINT=

# disabled | sandbox | live
VITE_PAYMENT_MODE=disabled
# true only when you intentionally need public source maps
VITE_BUILD_SOURCEMAP=false

# Server-only payment secrets are configured in Supabase Edge Functions, never here.
# PAYMENT_PROVIDER=...
# PAYMENT_GATEWAY_URL=...
# PAYMENT_GATEWAY_SECRET=...
# PAYMENT_WEBHOOK_SECRET=...
# PAYMENT_ALLOWED_ORIGIN=https://your-domain.example
